# systemd user service for deskwalk.
# Copy to ~/.config/systemd/user/deskwalk.service and adjust the path below
# (%h is your home folder), then: systemctl --user enable --now deskwalk
[Unit]
Description=deskwalk web controller for the WalkingPad
After=bluetooth.target network-online.target

[Service]
WorkingDirectory=%h/deskwalk
ExecStart=%h/deskwalk/.venv/bin/python server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
